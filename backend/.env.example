# Local open-weight inference. Install Ollama and pull the model first:
#   ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b

# Indic Parler-TTS runs locally; first run downloads the model weights.
PARLER_MODEL=ai4bharat/indic-parler-tts
TTS_DEVICE=auto
TTS_SPEAKER="A warm, expressive Indian storyteller with clear Hindi pronunciation, devotional warmth and measured pacing."

# Set MOCK_MODE=true for tests/demo without downloading model weights.
MOCK_MODE=true

# Legacy variable accepted for existing deployments; MOCK_MODE takes precedence.
# MOCK_SARVAM=true
