# Copy to .env (git-ignored; keep it chmod 600) and fill in. devenv loads .env into every process.
# Never paste keys or tokens into chat or commit them. Put settings here, not in devenv.nix.
# Comments are on their own lines on purpose: some dotenv parsers keep inline comments in the value.

# --- Sarvam (hosted; the default, and the fallback for the local models) ---
SARVAM_API_KEY=
# true = placeholder text + a tone, no API calls at all. false = real.
MOCK_SARVAM=false

# --- Which models to use ---
# sarvam = Sarvam only (default) | local = local only, fail if it is down | auto = local first, else Sarvam
TTS_PROVIDER=sarvam
LLM_PROVIDER=sarvam

# --- Local TTS server (see local_tts/SETUP.txt; start it with `local-tts` in `devenv shell`) ---
LOCAL_TTS_URL=http://127.0.0.1:8100
# Hugging Face read token, needed to download the gated model (huggingface.co/settings/tokens)
HF_TOKEN=
# Read by the TTS server itself (optional): LOCAL_TTS_SPEAKER=Divya  LOCAL_TTS_ENGINE=parler|stub
# LOCAL_TTS_PORT=8100  LOCAL_TTS_MODEL=ai4bharat/indic-parler-tts

# --- Optional local LLM: any OpenAI-compatible server (Ollama, llama.cpp llama-server, vLLM) ---
# Ollama example: LOCAL_LLM_URL=http://127.0.0.1:11434/v1  LOCAL_LLM_MODEL=<the model name you pulled>
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# --- Other knobs (all optional) ---
# Sarvam voice
# TTS_SPEAKER=shubh
# Leave mix layers out while listening: any of drone,scene,pulse,bells
# MIX_DISABLE=scene,pulse
# Turn the gentle shloka pitch lift off, or change its size (semitones, hard cap 3)
# PITCH_MODULATION=false
# SHLOKA_LIFT_ST=1.5
