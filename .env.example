# Copy to .env (git-ignored) and fill in. devenv loads .env into every process.
# Never paste keys or tokens into chat or commit them.

# --- Sarvam (hosted; the default, and the fallback for the local models) ---
SARVAM_API_KEY=
MOCK_SARVAM=false        # true = placeholder text + tone, no API calls at all

# --- Local open-source models ---
# sarvam = Sarvam only (default) | local = local only, fail if it is down | auto = local first, else Sarvam
TTS_PROVIDER=sarvam
LLM_PROVIDER=sarvam

# Local TTS server (see local_tts/SETUP.txt). Start it with the `local-tts` command in `devenv shell`.
LOCAL_TTS_URL=http://127.0.0.1:8100
# Hugging Face read token, needed once to download the gated model (create at huggingface.co/settings/tokens)
HF_TOKEN=

# Optional local LLM: any OpenAI-compatible server (Ollama, llama.cpp's llama-server, vLLM).
# Example for Ollama: LOCAL_LLM_URL=http://127.0.0.1:11434/v1  LOCAL_LLM_MODEL=<the model name you pulled>
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# --- Other knobs ---
# TTS_SPEAKER=shubh          Sarvam voice
# MIX_DISABLE=scene,pulse    leave mix layers out (drone, scene, pulse, bells)
# PITCH_MODULATION=false     turn off the gentle shloka pitch lift
